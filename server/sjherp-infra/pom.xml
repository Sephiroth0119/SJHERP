<?xml version="1.0" encoding="UTF-8"?>
<!--
  sjherp-infra：基础设施层

  职责：持久化（MySQL + Flyway 迁移）、LLM 抽象层的具体厂商实现（DeepSeek/通义/Claude/GPT 可切换）、
  向量库客户端（系统大记忆）。依赖方向：依赖 sjherp-domain（实现其仓储接口）与
  sjherp-agent（实现 AgentSessionRepository / LlmClient 等框架接口）——CLAUDE.md 允许该方向。
  注意：AgentReply 的 Jackson 序列化放在本模块（agent 模块保持零依赖纯 Java，不引 Jackson）。
-->
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.sjherp</groupId>
        <artifactId>sjherp-parent</artifactId>
        <version>0.1.0-SNAPSHOT</version>
    </parent>

    <artifactId>sjherp-infra</artifactId>
    <name>SJHERP Infrastructure</name>
    <description>持久化、LLM 抽象层实现、向量库客户端</description>

    <dependencies>
        <dependency>
            <groupId>com.sjherp</groupId>
            <artifactId>sjherp-domain</artifactId>
        </dependency>
        <!-- 实现 agent 模块的 AgentSessionRepository 等框架接口（依赖方向 infra -> agent，CLAUDE.md 允许） -->
        <dependency>
            <groupId>com.sjherp</groupId>
            <artifactId>sjherp-agent</artifactId>
        </dependency>

        <!-- 持久化：JdbcTemplate + HikariCP（版本统一走 Spring Boot BOM） -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-jdbc</artifactId>
        </dependency>
        <!-- MySQL 驱动 -->
        <dependency>
            <groupId>com.mysql</groupId>
            <artifactId>mysql-connector-j</artifactId>
            <scope>runtime</scope>
        </dependency>
        <!-- Flyway 数据库迁移（迁移脚本在本模块 src/main/resources/db/migration） -->
        <dependency>
            <groupId>org.flywaydb</groupId>
            <artifactId>flyway-core</artifactId>
        </dependency>
        <dependency>
            <groupId>org.flywaydb</groupId>
            <artifactId>flyway-mysql</artifactId>
        </dependency>
        <!-- AgentReply 协议 JSON 序列化（Jackson 只出现在 infra，agent 模块保持零依赖） -->
        <dependency>
            <groupId>com.fasterxml.jackson.core</groupId>
            <artifactId>jackson-databind</artifactId>
        </dependency>
        <!-- 密码哈希（M2-T05）：仅引 crypto 单模块（轻量，不含 Spring Security 全家桶），
             实现 domain 的 PasswordHasher 端口（BCrypt）；版本走 Spring Boot BOM -->
        <dependency>
            <groupId>org.springframework.security</groupId>
            <artifactId>spring-security-crypto</artifactId>
        </dependency>
        <!-- 单元测试（JUnit5 + AssertJ；DeepSeek 请求体组装/响应解析的结构断言） -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
        <!-- Testcontainers MySQL（X-2 DB 集成测试：真实 MySQL 8.4 跑全量 Flyway 迁移 + 仓储往返；
             @Tag("integration-db")，默认排除，CI 独立 job 执行；版本走 Spring Boot BOM（testcontainers-bom） -->
        <dependency>
            <groupId>org.testcontainers</groupId>
            <artifactId>mysql</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>
</project>
