<?xml version="1.0" encoding="UTF-8"?>
<!--
  sjherp-app：应用层（唯一可启动模块）

  职责：Agent 工具(Tool)定义（把领域服务包装为注册工具）、HTTP API、Agent 编排入口。
  依赖方向：app -> agent + domain + infra。
-->
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.sjherp</groupId>
        <artifactId>sjherp-parent</artifactId>
        <version>0.1.0-SNAPSHOT</version>
    </parent>

    <artifactId>sjherp-app</artifactId>
    <name>SJHERP Application</name>
    <description>应用层：API、Agent 工具定义、编排入口</description>

    <properties>
        <!-- JWT（M2-T05 认证）：jjwt 不在 Spring Boot BOM 内，版本在此统一管理 -->
        <jjwt.version>0.12.6</jjwt.version>
        <!-- springdoc-openapi 版本：knife4j-openapi3-starter 4.5.0 捆绑的 springdoc 2.3.0
             与 Spring Boot 3.4.x（Spring 6.2.x）的 ControllerAdviceBean API 不兼容；
             knife4j 4.4+ 的 groupConfigs() 从 List 改为 Set 也导致二进制不兼容。
             解决方案：只引入 knife4j-openapi3-ui（纯前端，无 Spring 依赖）+
             springdoc 2.7.0（兼容 Spring 6.2.x），绕过 knife4j starter 的 autoconfigure。 -->
        <springdoc.version>2.7.0</springdoc.version>
        <!-- Apache POI（M2-T09 期初 Excel 导入）：不在 Spring Boot BOM 内，显式锁定 -->
        <poi.version>5.2.5</poi.version>
    </properties>

    <dependencies>
        <dependency>
            <groupId>com.sjherp</groupId>
            <artifactId>sjherp-agent</artifactId>
        </dependency>
        <dependency>
            <groupId>com.sjherp</groupId>
            <artifactId>sjherp-domain</artifactId>
        </dependency>
        <dependency>
            <groupId>com.sjherp</groupId>
            <artifactId>sjherp-infra</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>
        <!-- Bean Validation（API 入参 DTO 的 @NotBlank/@NotNull/@Digits 等约束） -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation</artifactId>
        </dependency>
        <!-- 认证与授权（M2-T05）：JWT 过滤器链 + 角色限定（@PreAuthorize） -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-security</artifactId>
        </dependency>
        <!-- AOP（M2-T07）：审计切面拦截领域 Service 的 @Audited 写方法 -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-aop</artifactId>
        </dependency>
        <!-- JWT 签发与校验（HS256）：jjwt 三件套（api 编译期，impl/jackson 仅运行期） -->
        <dependency>
            <groupId>io.jsonwebtoken</groupId>
            <artifactId>jjwt-api</artifactId>
            <version>${jjwt.version}</version>
        </dependency>
        <dependency>
            <groupId>io.jsonwebtoken</groupId>
            <artifactId>jjwt-impl</artifactId>
            <version>${jjwt.version}</version>
            <scope>runtime</scope>
        </dependency>
        <dependency>
            <groupId>io.jsonwebtoken</groupId>
            <artifactId>jjwt-jackson</artifactId>
            <version>${jjwt.version}</version>
            <scope>runtime</scope>
        </dependency>
        <!-- Apache POI（M2-T09 期初数据导入）：XSSFWorkbook 读写 .xlsx 模板；
             不在 Spring Boot BOM 内，版本在此统一管理；仅 app 层导入端点使用。
             传递引入 poi 核心 / xmlbeans / commons-compress。 -->
        <dependency>
            <groupId>org.apache.poi</groupId>
            <artifactId>poi-ooxml</artifactId>
            <version>${poi.version}</version>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
        <!-- Spring Security 测试支持（M2-T06：@PreAuthorize 的 MockMvc 测试，构造认证主体） -->
        <dependency>
            <groupId>org.springframework.security</groupId>
            <artifactId>spring-security-test</artifactId>
            <scope>test</scope>
        </dependency>
        <!-- Testcontainers MySQL（D-8 幽灵审计修复的集成验证 GhostAuditPreventionIntegrationTest：
             外层事务回滚后 audit_log 必须无记录；@Tag("integration-db")，默认排除，
             CI 的 backend-integration-db job 执行；版本走 Spring Boot BOM） -->
        <dependency>
            <groupId>org.testcontainers</groupId>
            <artifactId>mysql</artifactId>
            <scope>test</scope>
        </dependency>
        <!-- API 可视化文档（仅 dev/local profile 启用，生产 springdoc.api-docs.enabled=false）：
             - springdoc-openapi-starter-webmvc-ui 2.7.0：提供 /v3/api-docs 元数据接口，
               适配 Spring Boot 3.4.x（Spring 6.2.x）；
             - knife4j-openapi3-ui 4.5.0：仅引入 knife4j 前端静态资源（/doc.html、/webjars/**），
               不引入 knife4j 的 Spring autoconfigure（后者依赖已废弃的 springdoc 2.3.x API，
               与 springdoc 2.4+ 的 SpringDocConfigProperties.getGroupConfigs() 返回类型不兼容）。
             综合效果：/doc.html 使用 knife4j 美化界面，/v3/api-docs 由 springdoc 2.7.0 生成，
             JWT Authorize 按钮通过 OpenApiConfig 的 securityScheme 全局生效。 -->
        <dependency>
            <groupId>org.springdoc</groupId>
            <artifactId>springdoc-openapi-starter-webmvc-ui</artifactId>
            <version>${springdoc.version}</version>
        </dependency>
        <dependency>
            <groupId>com.github.xiaoymin</groupId>
            <artifactId>knife4j-openapi3-ui</artifactId>
            <version>4.5.0</version>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <!-- 只有 app 模块打可执行 jar -->
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
            </plugin>
        </plugins>
    </build>
</project>
