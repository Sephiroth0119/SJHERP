# SJHERP 生产环境变量模板（复制为 deploy/.env 后修改）
# - 本文件可提交；deploy/.env 已被 git 忽略，禁止把真实密钥提交进仓库
# - 安装脚本 ./deploy/install.sh 会在缺少 .env 时自动复制本模板并生成随机密钥
# - 示例值仅供 compose config / CI 校验，生产务必替换

# ---- 对外访问 / TLS（M8-T03）----
# off = 仅 HTTP（本机开发）；self-signed = 安装时生成自签证书；custom = 使用 deploy/certs/ 里的正式证书
SJHERP_TLS_MODE=self-signed
SJHERP_HTTP_PORT=80
SJHERP_HTTPS_PORT=443

# ---- MySQL（仅容器内网，不映射到公网）----
MYSQL_ROOT_PASSWORD=changeMe-root-password-example-9
MYSQL_DATABASE=sjherp
MYSQL_USER=sjherp_app
SJHERP_DB_PASSWORD=changeMe-db-password-example-9

# 应用数据源：生产 compose 内主机名是 mysql，不要改成 localhost
SJHERP_DB_URL='jdbc:mysql://mysql:3306/sjherp?characterEncoding=utf8&useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=UTC'
SJHERP_DB_USERNAME=sjherp_app

# ---- 认证（首次启动创建 admin；已有用户后不会覆盖密码）----
# JWT 签名密钥，必须 ≥ 32 字节随机串
SJHERP_JWT_SECRET=changeMe-jwt-secret-must-be-at-least-32-bytes
# 初始管理员密码：≥ 8 位，须同时含大写、小写和数字。用户名固定为 admin
SJHERP_ADMIN_PASSWORD=ChangeMeAdmin9

# ---- Qdrant（大记忆派生索引；默认不启用记忆也可启动）----
SJHERP_QDRANT_URL=http://qdrant:6333
SJHERP_MEMORY_ENABLED=false

# ---- LLM（可留空：聊天回退占位 Agent，传统工作台仍可用）----
SJHERP_LLM_API_KEY=
# 第三方模型告知（聊天页横幅）；脱敏只打手机/邮箱/身份证，默认关
SJHERP_LLM_NOTICE=true
SJHERP_LLM_REDACT=false
# true 时 chat provider 不得指向公网（启动失败）。本地 Ollama 示例见 docs/部署-安全基线.md
SJHERP_LLM_LOCAL_ONLY=false

# ---- API 限流（登录 / 聊天发消息；可用环境变量调整）----
SJHERP_RATE_LIMIT_ENABLED=true
SJHERP_RATE_LIMIT_LOGIN=20
SJHERP_RATE_LIMIT_CHAT=60

# 生产禁止激活 local/dev（会开放 swagger）。排障才设 false
SJHERP_FORBID_DEV_PROFILE=true

# ---- 检查 Agent 定时巡检（生产建议打开；ERROR 只告警不静默修数）----
SJHERP_CONSISTENCY_ENABLED=true

# ---- 备份（M8-T02；不是密钥）----
# 落盘：deploy/backups/mysql/ 与 deploy/backups/qdrant/
# backup.sh 会删除超过该天数的 sjherp-*.sql.gz / sjherp-*.snapshot
SJHERP_BACKUP_KEEP_DAYS=14
